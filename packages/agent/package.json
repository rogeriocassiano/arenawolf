{
  "name": "arena-wolf-agent",
  "version": "1.0.4",
  "description": "Agente Arena Wolf — LAN House Client para Windows",
  "main": "dist/main.js",
  "scripts": {
    "dev": "concurrently \"tsc --watch\" \"electron .\"",
    "build": "tsc && electron-builder",
    "build:win": "tsc && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "build": {
    "appId": "com.arenawolf.agent",
    "productName": "Arena Wolf Agent",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "rogeriocassiano",
        "repo": "arenawolf",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "electron-store": "^8.1.0",
    "electron-updater": "6.8.11",
    "node-windows": "^1.0.0-beta.8",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
